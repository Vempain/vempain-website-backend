<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spring Boot's default console logging for the application, plus a second console appender for the access log: the logger
  vempain.site.access (AccessLogFilter) writes one JSON object per request, and this appender prints that message alone, so
  every access line on stdout is a complete JSON document for the host's log collector. Levels stay configurable through
  logging.level.* as before.
-->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

  <appender name="ACCESS" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <charset>UTF-8</charset>
      <pattern>%msg%n</pattern>
    </encoder>
  </appender>

  <logger name="vempain.site.access" level="INFO" additivity="false">
    <appender-ref ref="ACCESS"/>
  </logger>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
